+// Helper function to convert OSType to FourCC string
+private func fourCCToString(_ value: OSType) -> String {
+  let bytes = [
+    UInt8((value >> 24) & 0xFF),
+    UInt8((value >> 16) & 0xFF),
+    UInt8((value >> 8) & 0xFF),
+    UInt8(value & 0xFF)
+  ]
+  let isPrintable = bytes.allSatisfy { $0 >= 32 && $0 < 127 }
+  if isPrintable, let str = String(bytes: bytes, encoding: .ascii) {
+    return str
+  }
+  return "????"
+}
